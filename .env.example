# Todas as variáveis são opcionais; os valores abaixo são os padrões.
# Valor inválido interrompe a inicialização. O arquivo é só referência: nada o carrega automaticamente.
PORT=3000

# memory: tudo em memória (padrão, sem dependências). postgres: exige DATABASE_URL.
PERSISTENCE=memory
# DATABASE_URL=postgres://bcb:bcb@localhost:5432/bcb

# async: worker em segundo plano | sync: processa dentro da requisição
QUEUE_MODE=async
# Máximo de urgentes seguidas enquanto houver normal esperando (proteção contra starvation).
URGENT_BURST=3
# Tentativas de entrega antes de marcar a mensagem como failed e estornar.
MAX_ATTEMPTS=3
# Espera antes da 2ª tentativa; dobra a cada nova tentativa.
RETRY_BACKOFF_MS=200
# Duração da entrega simulada (0 = instantânea).
PROCESSING_DELAY_MS=0
